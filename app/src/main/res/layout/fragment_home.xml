<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Active Personas Horizontal Filter Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/layout_persona_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

        </HorizontalScrollView>

        <!-- Hero Weather Card with Gradient -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            android:backgroundTint="#0B192C">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_hero_gradient"
                android:padding="20dp">

                <!-- City & Time Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_hero_city"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delhi NCR"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_on_dark" />

                        <TextView
                            android:id="@+id/tv_hero_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Live IMD Station Feed • Today"
                            android:textSize="12sp"
                            android:textColor="@color/text_on_dark_sec" />

                    </LinearLayout>

                    <!-- Weather Emoji Icon -->
                    <TextView
                        android:id="@+id/tv_hero_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌫️"
                        android:textSize="44sp" />

                </LinearLayout>

                <!-- Temp & Condition Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/tv_hero_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18°"
                        android:textSize="54sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_on_dark"
                        android:includeFontPadding="false" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginBottom="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_hero_condition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dense Smog &amp; Haze"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_on_dark" />

                        <TextView
                            android:id="@+id/tv_hero_feels_like"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Feels like 17°C"
                            android:textSize="12sp"
                            android:textColor="@color/text_on_dark_sec" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Quick Metrics Pill Strip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:divider="?android:attr/dividerHorizontal"
                    android:showDividers="middle">

                    <TextView
                        android:id="@+id/tv_hero_humidity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💧 82% Hum"
                        android:textSize="12sp"
                        android:textColor="@color/text_on_dark_sec" />

                    <TextView
                        android:id="@+id/tv_hero_wind"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💨 6 km/h NW"
                        android:textSize="12sp"
                        android:textColor="@color/text_on_dark_sec" />

                    <TextView
                        android:id="@+id/tv_hero_aqi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🫁 AQI 385"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FCA5A5" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Emergency Alert Banner (Visible when alert is active) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_emergency_alert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#EF4444"
            android:backgroundTint="#FEF2F2"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚨"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tv_emergency_alert_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="SEVERE WEATHER ALERT ACTIVE"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#991B1B"
                    android:lineSpacingMultiplier="1.2" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Hourly Forecast Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hourly Timeline &amp; AQI"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24h Forecast"
                android:textSize="12sp"
                android:textColor="@color/primary_variant" />

        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_hourly_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <!-- Section Header for Personalized Insight Feed -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Personalized Intelligence Feed"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tv_active_persona_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 Personas Active"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary_variant"
                android:background="@drawable/bg_metric_tile"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />

        </LinearLayout>

        <!-- Dynamic Insight Cards Container -->
        <LinearLayout
            android:id="@+id/layout_cards_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>