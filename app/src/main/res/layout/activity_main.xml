<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top MoES / IMD Header Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:background="@color/surface"
        android:elevation="3dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAUSAM"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_variant"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="PERSONAL"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/surface"
                    android:background="@drawable/bg_badge_high"
                    android:backgroundTint="@color/accent_orange" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="MoES / IMD Personalized Decision Engine"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <!-- Location Switcher Chip Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_city_selector"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="📍 Delhi NCR ▾"
            android:textSize="12sp"
            android:textColor="@color/primary_variant"
            app:cornerRadius="19dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp"
            android:textAllCaps="false" />

    </LinearLayout>

    <!-- Main Fragment Container -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/primary_variant"
        app:itemTextColor="@color/primary_variant"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
