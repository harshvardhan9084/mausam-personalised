<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    android:backgroundTint="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Card Top Header: Emoji + Title/Subtitle + Priority Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_domain_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:textSize="24sp"
                android:background="@drawable/bg_metric_tile" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_card_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Air Quality &amp; Health Shield"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tv_card_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="AQI 385 • Severe / Hazardous"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_priority_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="⚠️ HIGH"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/status_danger"
                android:background="@drawable/bg_badge_critical" />

        </LinearLayout>

        <!-- Secondary Metrics Row -->
        <LinearLayout
            android:id="@+id/layout_metrics_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- Dynamically populated metric tiles -->

        </LinearLayout>

        <!-- Actionable Advisories Container -->
        <LinearLayout
            android:id="@+id/layout_advisories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="12dp"
            android:background="@drawable/bg_metric_tile"
            android:orientation="vertical">

            <!-- Dynamically populated bullet points -->

        </LinearLayout>

        <!-- Explainable AI: "Why am I seeing this?" Header / Toggle -->
        <LinearLayout
            android:id="@+id/layout_why_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingVertical="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✨ Explainable AI: Why am I seeing this?"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary_variant" />

            <TextView
                android:id="@+id/tv_score_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="92% Match ▾"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/surface"
                android:background="@drawable/bg_badge_good"
                android:backgroundTint="@color/primary_variant" />

        </LinearLayout>

        <!-- Collapsible Explainable AI Breakdown Content -->
        <LinearLayout
            android:id="@+id/layout_why_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="#F8FAFC"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scoring Formula Weights:"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary" />

            <!-- 4 Factor Bars Container -->
            <LinearLayout
                android:id="@+id/layout_score_factors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <!-- Trigger Reasons Container -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Meteorological Triggers:"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:id="@+id/layout_trigger_reasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- Action CTA Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_card_action"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="Take Action"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:textAllCaps="false"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
