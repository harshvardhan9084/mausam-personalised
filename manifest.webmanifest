{
  "name": "Mausam — Personalised Weather",
  "short_name": "Mausam",
  "description": "Personalised weather dashboards for India. One forecast, five points of view — fitness, commute, farm, travel and events. Powered by Open-Meteo.",
  "id": "/mausam-personalised/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0f1117",
  "theme_color": "#0f1117",
  "lang": "en-IN",
  "categories": ["weather", "utilities", "lifestyle"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Fitness dashboard", "url": "./index.html?persona=fitness", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Commuter dashboard", "url": "./index.html?persona=commuter", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
